# Copy this file to .env and replace the placeholders.
# Never put real credentials in this template or commit your .env file.

DB_PASSWORD=replace_with_your_postgres_password
GOOGLE_CLIENT_ID=replace_with_your_web_oauth_client_id.apps.googleusercontent.com
READING_SANCTUARY_JWT_SECRET=replace_with_a_base64_encoded_32_byte_secret
